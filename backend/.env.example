# GramSetu Backend – Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER put real credentials in this file.

# Server
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gramsetu_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# JWT (will be used in Phase 2)
JWT_SECRET=your_strong_jwt_secret_here
JWT_EXPIRES_IN=7d
